{
  "$defs": {
    "CharacterizationEntry": {
      "title": "CharacterizationEntry",
      "properties": {
        "ExperimentId": {
          "type": "string"
        },
        "Characterization": {
          "properties": {
            "Pxrd": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PxrdMetadata"
              }
            },
            "Weight": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Weight"
              }
            }
          },
          "required": [
            "Pxrd"
          ],
          "type": "object"
        }
      },
      "required": [
        "Characterization",
        "ExperimentId"
      ],
      "type": "object"
    },
    "PxrdMetadata": {
      "properties": {
        "RelativeFilePath": {
          "format": "iri",
          "type": "string"
        },
        "XRaySource": {
          "$ref": "#/$defs/X-ray_source"
        },
        "SampleHolder": {
          "$ref": "#/$defs/SampleHolder"
        },
        "OtherMetadata": {
          "type": "string"
        }
      },
      "required": [
        "RelativeFilePath",
        "XRaySource",
        "SampleHolder"
      ],
      "title": "PXRD",
      "type": "object"
    },
    "SampleHolder": {
      "properties": {
        "Diameter": {
          "$ref": "#/$defs/Length"
        },
        "Type": {
          "$ref": "#/$defs/SampleHolderType"
        }
      },
      "type": "object",
      "required": [
        "Type",
        "Diameter"
      ]
    },
    "X-ray_source": {
      "enum": [
        "Co Kα1",
        "Cu Kα1"
      ],
      "type": "string"
    },
    "Weight": {
      "title": "Weight",
      "properties": {
        "Unit": {
          "$ref": "#/$defs/WeightUnit"
        },
        "Value": {
          "type": "number",
          "minimum": 0
        }
      },
      "type": "object",
      "required": [
        "Value",
        "Unit"
      ]
    },
    "Length": {
      "title": "Length",
      "properties": {
        "Unit": {
          "$ref": "#/$defs/LengthUnit"
        },
        "Value": {
          "type": "number",
          "minimum": 0
        }
      },
      "type": "object",
      "required": [
        "Value",
        "Unit"
      ]
    },
    "LengthUnit": {
      "title": "LengthUnit",
      "enum": [
        "millimeter",
        "centimeter",
        "meter"
      ],
      "type": "string"
    },
    "WeightUnit": {
      "title": "WeightUnit",
      "enum": [
        "microgram",
        "milligram",
        "gram"
      ],
      "type": "string"
    },
    "SampleHolderType": {
      "title": "SampleHolderType",
      "type": "string",
      "enum": [
        "HILGENBERG_GLASS_NO_14_CAPILLARY",
        "KAPTON_FILMS"
      ]
    }
  },
  "properties": {
    "ProductCharacterization": {
      "items": {
        "$ref": "#/$defs/CharacterizationEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "ProductCharacterization"
  ],
  "title": "Characterization",
  "type": "object",
  "description": "characterization data and analysis results of products from the MOF synthesis test cases"
}