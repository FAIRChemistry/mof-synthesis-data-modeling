{
  "conventions": {
    "convertedFolder": "converted",
    "artifacts": {
      "sciformation_cleaned": {
        "suffix": "_eln_cleaned",
        "extension": ".json"
      },
      "sciformation_enriched": {
        "suffix": "_eln_enriched",
        "extension": ".json"
      },
      "chemotion_cleaned": {
        "suffix": "_cleaned",
        "extension": ".json"
      },
      "chemotion_enriched": {
        "suffix": "_enriched",
        "extension": ".json"
      },
      "procedure": {
        "prefix": "procedure_from_",
        "extension": ".json"
      },
      "characterization": {
        "prefix": "characterization_from_",
        "extension": ".json"
      },
      "xdl": {
        "prefix": "xdl_from_",
        "extension": ".xml"
      },
      "params": {
        "prefix": "params_from_",
        "extension": ".json"
      },
      "mpif_output_folder": {
        "fixedName": "mpif_outputs"
      }
    }
  },
  "steps": {
    "sciformation_to_mofsy": {
      "kind": "python",
      "entrypoint": "fair_synthesis.formatting.sciformation2mofsy",
      "produces": [
        "sciformation_cleaned",
        "sciformation_enriched",
        "procedure",
        "characterization"
      ]
    },
    "chemotion_to_mofsy_with_text_extraction": {
      "kind": "python",
      "entrypoint": "fair_synthesis.formatting.chemotion2mofsy",
      "produces": [
        "chemotion_cleaned",
        "chemotion_enriched",
        "procedure",
        "characterization"
      ]
    },
    "chemotion_to_mofsy_without_text_extraction": {
      "kind": "python",
      "entrypoint": "fair_synthesis.formatting.chemotion2mofsy",
      "produces": [
        "chemotion_cleaned",
        "chemotion_enriched",
        "procedure",
        "characterization"
      ]
    },
    "fe_terephthalate_to_mofsy": {
      "kind": "python",
      "entrypoint": "fair_synthesis.formatting.fe_terephthalate2mofsy",
      "produces": [
        "procedure",
        "characterization"
      ]
    },
    "mofsy_to_xdl": {
      "kind": "python",
      "entrypoint": "fair_synthesis.serialization.mofsy2xdl",
      "requires": [
        "procedure"
      ],
      "produces": [
        "xdl"
      ]
    },
    "extract_mocof1_params": {
      "kind": "python",
      "entrypoint": "fair_synthesis.serialization.extract_interesting_params",
      "requires": [
        "procedure",
        "characterization"
      ],
      "produces": [
        "params"
      ]
    },
    "mofsy_to_mpif": {
      "kind": "node",
      "entrypoint": "scripts/mofsy2mpif/src/mofsy2mpif.ts",
      "requires": [
        "procedure",
        "characterization",
        "mpif_params"
      ],
      "produces": [
        "mpif_output_folder"
      ]
    }
  },
  "workflows": {
    "sciformation_workflow": [
      "sciformation_to_mofsy",
      "mofsy_to_xdl",
      "extract_mocof1_params",
      "mofsy_to_mpif"
    ],
    "chemotion_workflow_with_text_extraction": [
      "chemotion_to_mofsy_with_text_extraction",
      "mofsy_to_xdl",
      "mofsy_to_mpif"
    ],
    "chemotion_workflow_without_text_extraction": [
      "chemotion_to_mofsy_without_text_extraction",
      "mofsy_to_xdl",
      "mofsy_to_mpif"
    ],
    "fe_terephthalate_workflow": [
      "fe_terephthalate_to_mofsy",
      "mofsy_to_xdl",
      "mofsy_to_mpif"
    ]
  },
  "sources": [
    {
      "id": "mocof-1-sciformation",
      "format": "sciformation",
      "workflow": "sciformation_workflow",
      "root": "data/MOCOF-1",
      "input": "Sciformation_KE-MOCOF_jsonRaw.json",
      "basename": "sciformation",
      "pxrdFolder": "PXRD",
      "mpifParams": "mpif_params.json",
      "options": {
        "sciformationEnrichmentProfile": "mocof1"
      }
    },
    {
      "id": "mocof-1-chemotion",
      "format": "chemotion",
      "workflow": "chemotion_workflow_with_text_extraction",
      "root": "data/MOCOF-1_Chemotion",
      "input": "chemotion_export.json",
      "basename": "chemotion",
      "mpifParams": "mpif_params.json",
      "optional": true
    },
    {
      "id": "zr-nu-1000-chemotion",
      "format": "chemotion",
      "workflow": "chemotion_workflow_without_text_extraction",
      "root": "data/Zr-NU-1000",
      "input": "export.json",
      "basename": "chemotion",
      "mpifParams": "mpif_params.json"
    },
    {
      "id": "fe-terephthalate",
      "format": "fe_terephthalate",
      "workflow": "fe_terephthalate_workflow",
      "root": "data/Fe–terephthalate",
      "input": "converted/Fe–terephthalate.json",
      "basename": "Fe–terephthalate",
      "pxrdFolder": "PXRD",
      "mpifParams": "mpif_params.json"
    }
  ]
}
