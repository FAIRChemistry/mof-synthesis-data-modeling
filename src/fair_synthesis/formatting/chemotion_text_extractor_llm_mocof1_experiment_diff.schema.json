{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ChemotionExperimentDiff.schema.json",
  "title": "ChemotionExperimentDiff",
  "type": "object",
  "properties": {
    "vessel": {
      "type": ["string", "null"],
      "enum": ["microwave vial", "Schlenk bomb", null]
    },
    "degassing": {
      "type": ["string", "null"],
      "enum": ["Ar", null]
    },
    "rinse": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["acetone", "Et3N", "MeCN", "NaCl aq", "DMF", "CHCl3", "MeOH", "EtOH"]
      }
    },
    "wait_after_rinse": {
      "type": ["number", "null"],
      "enum": [24, null]
    },
    "wait_after_rinse_unit": {
      "type": "string",
      "enum": ["h"]
    },
    "wash_solid": {
      "type": ["string", "null"],
      "enum": ["scCO2", "MeOH+scCO2", null]
    },
    "evaporate": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
